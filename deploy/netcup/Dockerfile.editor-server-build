ARG BASE_IMAGE=postiz-confenge:d98b1f0fb8dea293a16ce4f565fd791e6b00c1ac
FROM ${BASE_IMAGE} AS build
COPY . /app
RUN NODE_OPTIONS=--max-old-space-size=4096 pnpm run build:backend \
 && NODE_OPTIONS=--max-old-space-size=4096 pnpm run build:orchestrator

FROM scratch AS artifacts
COPY --from=build /app/apps/backend/dist /backend
COPY --from=build /app/apps/orchestrator/dist /orchestrator
