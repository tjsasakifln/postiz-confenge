ARG BASE_IMAGE=postiz-confenge:d98b1f0fb8dea293a16ce4f565fd791e6b00c1ac
FROM ${BASE_IMAGE} AS build
ARG NEXT_PUBLIC_BACKEND_URL
ARG NEXT_PUBLIC_VERSION
ENV NEXT_PUBLIC_VERSION=$NEXT_PUBLIC_VERSION \
    NEXT_PUBLIC_BACKEND_URL=$NEXT_PUBLIC_BACKEND_URL \
    STORAGE_PROVIDER=local \
    NEXT_TELEMETRY_DISABLED=1 \
    CONFENGE_BUILD_SOURCEMAPS=false
COPY . /app
RUN npm install --prefix /tmp/editor-deps --ignore-scripts --no-audit --no-fund fflate@0.8.2 \
 && cp -a /tmp/editor-deps/node_modules/fflate node_modules/fflate
RUN NODE_OPTIONS=--max-old-space-size=6144 pnpm run build:frontend
RUN rm -rf apps/frontend/.next/cache \
 && find apps/frontend/.next -type f -name '*.map' -delete \
 && cp -aL node_modules/fflate /tmp/fflate

FROM scratch AS artifacts
COPY --from=build /app/apps/frontend/.next /frontend
COPY --from=build /app/apps/frontend/public/confenge-studio /brand
COPY --from=build /tmp/fflate /fflate
